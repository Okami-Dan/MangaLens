<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Two uses, both opt-in. Section 4 stage 5: the models are fetched on first launch,
      not shipped. Section 5 tier 2: the recognized Japanese of a page goes to whichever
      OpenAI-compatible endpoint the user configured, and only when they tap translate.
      Tier 0 is the default and needs neither.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Tier 1's page job. docs/on-device-llm.md section 4: a page is 45-60 seconds of
      continuous CPU, which has to be a foreground service with a notification or Android
      will kill it the moment the phone goes into a pocket. Only requested; nothing starts
      one unless the user selects the on-device tier and taps translate.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Section 3.1: the app opens directly to the camera viewfinder. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MangaReader">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MangaReader">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          WorkManager declares SystemForegroundService with no foregroundServiceType, and
          since API 29 the type passed to startForeground() has to be a subset of the one
          on the manifest element. Tier 1 passes FOREGROUND_SERVICE_TYPE_DATA_SYNC, so
          without this override the very first tier-1 page takes the whole app down with
          "foregroundServiceType 0x00000001 is not a subset of 0x00000000".
        -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:replace="android:foregroundServiceType" />
    </application>

</manifest>
