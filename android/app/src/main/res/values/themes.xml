<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A neutral launch window avoids flashing an old image before the rotating art. -->
    <style name="Theme.MangaReader" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <color name="paper">#F0F0EF</color>
</resources>
