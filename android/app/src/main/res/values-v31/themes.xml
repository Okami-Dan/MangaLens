<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ always draws a system launch window. Keep its icon empty so the
         full Startup_screen artwork in MainActivity is the only branded launch view. -->
    <style name="Theme.MangaReader" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:windowSplashScreenBackground">@color/paper</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/empty_splash_icon</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
